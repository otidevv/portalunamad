<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portal UNAMAD - configuracion de IIS. Equivalente al .htaccess de Apache.
  Este archivo vive en public/, que es la raiz fisica del sitio en IIS.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 1) Canonico: solo el dominio va a HTTPS.
             El acceso de pruebas por IP:8080 NO se redirige, porque la condicion
             exige que la cabecera Host sea exactamente portal.unamad.edu.pe -->
        <rule name="Canonico HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^portal\.unamad\.edu\.pe$" />
          </conditions>
          <action type="Redirect" url="https://portal.unamad.edu.pe/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Quitar barra final salvo en directorios reales -->
        <rule name="Quitar barra final" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>

        <!-- 3) Front controller de Laravel -->
        <rule name="Front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="Quitar X-Powered-By">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- La aplicacion ya emite por middleware X-Content-Type-Options, X-Frame-Options,
             X-XSS-Protection, Referrer-Policy, X-Permitted-Cross-Domain-Policies y
             Permissions-Policy. No se repiten aqui: duplicarlas genera cabeceras en
             conflicto y algunos navegadores aplican la mas restrictiva de forma impredecible. -->
        <remove name="X-Powered-By" />
        <!-- HSTS: descomentar cuando HTTPS lleve dias funcionando sin incidencias.
             Una vez enviado, los navegadores lo recuerdan y no hay vuelta atras facil.
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="67108864" />
        <!-- OJO: aqui NO va "storage". La raiz del sitio es public/, asi que la carpeta
             storage/ de Laravel ya queda fuera del alcance del navegador. Lo unico
             llamado "storage" accesible por URL es public/storage, el enlace que sirve
             las imagenes subidas (anuncios, comunicados, avatars). Bloquearlo las rompe.
             Los demas segmentos estan igualmente fuera de la raiz: se dejan solo como
             defensa extra por si alguien reapunta el sitio a la raiz del proyecto. -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="vendor" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <!-- El .htaccess declaraba image/webp a mano; IIS tampoco lo trae -->
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" /><mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" /><mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".mp3" /><mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <!-- Equivale al Cache-Control de 300 s que el .htaccess ponia a html/php -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>

  <!-- Assets con hash de Vite: cache de un ano, inmutable -->
  <location path="build">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Imagenes, audio y js estatico: un ano, como en el .htaccess original -->
  <location path="img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="audio">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Imagenes subidas (anuncios, comunicados, avatars). Laravel les pone nombre
       aleatorio al guardarlas, asi que una URL dada nunca cambia de contenido:
       cachear un ano es seguro. El .htaccess original hacia lo mismo por extension. -->
  <location path="storage">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
